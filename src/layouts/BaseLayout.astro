---
import '../styles/global.css';
import { SITE_CONFIG, ATTRACTION, FAQS } from '../lib/seo';

export interface BreadcrumbItem {
  name: string;
  path: string;
}
export interface SchemaFaq {
  q: string;
  a: string;
}

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  robots?: string;
  /** 'home' mantiene el esquema completo del atractivo; 'topic' usa esquema propio de guía. */
  pageType?: 'home' | 'topic';
  ogTitle?: string;
  keywords?: string;
  breadcrumbs?: readonly BreadcrumbItem[];
  faqs?: readonly SchemaFaq[];
  dateModified?: string;
}

const {
  title,
  description,
  canonicalPath = '/',
  ogImage = ATTRACTION.heroImage,
  robots = 'index,follow',
  pageType = 'home',
  ogTitle,
  keywords,
  breadcrumbs = [],
  faqs = [],
  dateModified
} = Astro.props;
const isTopic = pageType === 'topic';
const canonicalUrl = `${SITE_CONFIG.origin}${canonicalPath}`;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `${SITE_CONFIG.origin}${ogImage}`;
const resolvedOgTitle = ogTitle ?? (isTopic ? title : `${ATTRACTION.fullName} — Guía turística de ${ATTRACTION.city}`);
const resolvedKeywords = keywords ?? `Plaza de la Liberación, Plaza Liberación, Guadalajara, Jalisco, México, atracción turística, ubicación, mapa, ${ATTRACTION.fullName}`;

// JSON-LD: TouristAttraction (anclaje de entidad geográfica).
const attractionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TouristAttraction',
  '@id': `${SITE_CONFIG.origin}/#attraction`,
  name: ATTRACTION.fullName,
  alternateName: [...ATTRACTION.alternateName],
  description: `Guía independiente de ${ATTRACTION.fullName} en ${ATTRACTION.city}, ${ATTRACTION.state}.`,
  url: SITE_CONFIG.origin,
  image: [`${SITE_CONFIG.origin}${ATTRACTION.heroImage}`],
  touristType: ['Cultural tourism', 'Historical tourism', 'Urban tourism'],
  address: {
    '@type': 'PostalAddress',
    addressLocality: ATTRACTION.city,
    addressRegion: ATTRACTION.state,
    postalCode: ATTRACTION.postalCode,
    addressCountry: ATTRACTION.countryCode
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: ATTRACTION.latitude,
    longitude: ATTRACTION.longitude
  },
  hasMap: ATTRACTION.mapsShareUrl,
  sameAs: [ATTRACTION.mapsShareUrl],
  containedInPlace: {
    '@type': 'City',
    name: ATTRACTION.city,
    containedInPlace: {
      '@type': 'AdministrativeArea',
      name: ATTRACTION.state,
      containedInPlace: {
        '@type': 'Country',
        name: ATTRACTION.country
      }
    }
  }
};

// JSON-LD: FAQPage (preguntas frecuentes para featured snippets).
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map((faq) => ({
    '@type': 'Question',
    name: faq.name,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.acceptedAnswer
    }
  }))
};

// JSON-LD: WebSite (descripción general del dominio).
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE_CONFIG.origin}/#website`,
  url: SITE_CONFIG.origin,
  name: SITE_CONFIG.name,
  inLanguage: SITE_CONFIG.language,
  publisher: {
    '@type': 'Organization',
    name: SITE_CONFIG.name,
    url: SITE_CONFIG.origin
  }
};

// JSON-LD: WebPage (referencia a la TouristAttraction enlazada por @id).
const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: title,
  description,
  inLanguage: SITE_CONFIG.language,
  isPartOf: { '@id': `${SITE_CONFIG.origin}/#website` },
  about: { '@id': `${SITE_CONFIG.origin}/#attraction` },
  primaryImageOfPage: {
    '@type': 'ImageObject',
    contentUrl: ogImageUrl
  }
};

// Esquema exclusivo de las guías temáticas: un @graph con WebSite, WebPage,
// BreadcrumbList y FAQPage propia. El atractivo se referencia por @id para no
// repetir 36 veces la ficha completa ni emitir un AggregateRating de terceros.
const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  '@id': `${canonicalUrl}#breadcrumb`,
  itemListElement: breadcrumbs.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.name,
    item: `${SITE_CONFIG.origin}${crumb.path}`
  }))
};

const topicFaqJsonLd = {
  '@type': 'FAQPage',
  '@id': `${canonicalUrl}#faq`,
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a }
  }))
};

const topicWebPageJsonLd = {
  '@type': 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: title,
  description,
  inLanguage: SITE_CONFIG.language,
  isPartOf: { '@id': `${SITE_CONFIG.origin}/#website` },
  about: { '@id': `${SITE_CONFIG.origin}/#attraction` },
  primaryImageOfPage: {
    '@type': 'ImageObject',
    contentUrl: ogImageUrl
  },
  breadcrumb: { '@id': `${canonicalUrl}#breadcrumb` },
  ...(dateModified ? { dateModified } : {})
};

const topicGraphJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': websiteJsonLd['@id'], url: websiteJsonLd.url, name: websiteJsonLd.name, inLanguage: websiteJsonLd.inLanguage, publisher: websiteJsonLd.publisher },
    {
      '@type': 'TouristAttraction',
      '@id': `${SITE_CONFIG.origin}/#attraction`,
      name: ATTRACTION.fullName,
      url: SITE_CONFIG.origin,
      hasMap: ATTRACTION.mapsShareUrl
    },
    topicWebPageJsonLd,
    breadcrumbJsonLd,
    ...(faqs.length ? [topicFaqJsonLd] : [])
  ]
};

---

<!doctype html>
<html lang={SITE_CONFIG.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <!-- ===== TDK ===== -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={resolvedKeywords} />
    <meta name="robots" content={robots} />
    <meta name="author" content={SITE_CONFIG.name} />
    <meta name="geo.region" content={`MX-${ATTRACTION.countryCode === 'MX' ? 'JAL' : ''}`} />
    <meta name="geo.placename" content={`${ATTRACTION.fullName}, ${ATTRACTION.city}`} />
    <meta name="geo.position" content={`${ATTRACTION.latitude};${ATTRACTION.longitude}`} />
    <meta name="ICBM" content={`${ATTRACTION.latitude}, ${ATTRACTION.longitude}`} />
    <meta name="theme-color" content={SITE_CONFIG.themeColor} />
    <meta name="color-scheme" content="light" />

    <!-- ===== Canonical ===== -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- ===== Favicon & PWA ===== -->
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
    <link rel="apple-touch-icon" type="image/png" sizes="180x180" href="/icons/favicon-180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Plaza Liberación" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="application-name" content="Plaza Liberación" />
    <meta name="format-detection" content="telephone=no" />

    <!-- ===== Open Graph ===== -->
    <meta property="og:type" content={isTopic ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE_CONFIG.name} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="800" />
    <meta property="og:image:alt" content="Composición geométrica original; no fotografía ni plano de la plaza" />
    <meta property="og:locale" content={SITE_CONFIG.ogLocale} />

    <!-- ===== Twitter / X ===== -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Composición geométrica original; no fotografía ni plano de la plaza" />

    <!-- ===== hreflang básico ===== -->
    <link rel="alternate" hreflang="es-MX" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- ===== JSON-LD: esquema propio de cada tipo de página ===== -->
    {isTopic && <script type="application/ld+json" set:html={JSON.stringify(topicGraphJsonLd)} is:inline></script>}

    <!-- TouristAttraction: ficha completa sólo en la portada -->
    {!isTopic && !robots.includes('noindex') && <script type="application/ld+json" set:html={JSON.stringify(attractionJsonLd)} is:inline></script>}
    {!isTopic && <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} is:inline></script>}
    {!isTopic && <script type="application/ld+json" set:html={JSON.stringify(webPageJsonLd)} is:inline></script>}
    {!isTopic && !robots.includes('noindex') && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} is:inline></script>}

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">Saltar al contenido principal</a>

    <slot />

    <!-- Service Worker registration (PWA) -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register('/sw.js', { scope: '/' })
            .catch((err) => console.warn('SW registration failed:', err));
        });
      }
    </script>


    <style is:global>
      /* Variable runtime para SECTUR y links */
      :root { color-scheme: light; }
    </style>
  </body>
</html>