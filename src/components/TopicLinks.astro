---
import {
  TOPICS,
  TOPIC_GROUPS,
  TOPIC_GROUP_ORDER,
  TOPICS_UPDATED,
  topicsByGroup,
  topicPath,
  type TopicGroupId
} from '../data/topics';
import { ATTRACTION } from '../lib/seo';

const groups = TOPIC_GROUP_ORDER.map((id: TopicGroupId) => ({
  id,
  label: TOPIC_GROUPS.find((g) => g.id === id)!.label,
  intro: TOPIC_GROUPS.find((g) => g.id === id)!.intro,
  topics: topicsByGroup(id)
}));
---

<section id="guias" class="py-14 lg:py-20 bg-[var(--color-surface-alt)] border-y border-[var(--color-border)]">
  <div class="container-narrow">
    <header class="max-w-3xl">
      <p class="text-xs uppercase tracking-[0.18em] font-semibold text-[var(--color-accent)]">
        Guías de visita · {TOPICS.length} páginas
      </p>
      <h2 class="mt-3">Explora la Plaza de la Liberación por temas</h2>
      <p class="mt-4 text-lg text-[var(--color-ink-soft)]">
        Cada guía responde una pregunta distinta sobre {ATTRACTION.fullName} en {ATTRACTION.city}: historia,
        cómo llegar, qué ver, rutas a pie y decisiones prácticas. Todas están escritas en español y revisadas el {TOPICS_UPDATED}.
      </p>
    </header>

    <!-- ===== Accesos rápidos (prioridad móvil) ===== -->
    <nav aria-label="Guías más consultadas" class="mt-8">
      <ul class="grid grid-cols-2 sm:grid-cols-3 gap-3">
        <li><a class="btn-secondary w-full justify-center text-sm" href="/historia/">Historia</a></li>
        <li><a class="btn-secondary w-full justify-center text-sm" href="/como-llegar/">Cómo llegar</a></li>
        <li><a class="btn-secondary w-full justify-center text-sm" href="/horarios-y-acceso/">Horarios y acceso</a></li>
        <li><a class="btn-secondary w-full justify-center text-sm" href="/que-ver/">Qué ver</a></li>
        <li><a class="btn-secondary w-full justify-center text-sm" href="/ruta-medio-dia/">Ruta de medio día</a></li>
        <li><a class="btn-secondary w-full justify-center text-sm" href="/preguntas-frecuentes/">Preguntas frecuentes</a></li>
      </ul>
    </nav>

    <!-- ===== Índice completo por grupos ===== -->
    <div class="mt-12 grid gap-6 md:grid-cols-2">
      {groups.map((group) => (
        <section class="surface-card p-6" aria-labelledby={`grupo-${group.id}`}>
          <h3 id={`grupo-${group.id}`} class="text-xl">{group.label}</h3>
          <p class="mt-2 text-sm text-[var(--color-ink-soft)]">{group.intro}</p>
          <ul class="mt-4 space-y-3">
            {group.topics.map((topic) => (
              <li class="flex flex-col gap-0.5 border-t border-[var(--color-border)] pt-3 first:border-t-0 first:pt-0">
                <a class="font-semibold" href={topicPath(topic.slug)}>
                  <span class="text-xs text-[var(--color-ink-soft)] font-normal mr-2">{String(topic.num).padStart(2, '0')}</span>
                  {topic.cardTitle}
                </a>
                <span class="text-sm text-[var(--color-ink-soft)]">{topic.cardText}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <p class="mt-8 text-xs text-[var(--color-ink-soft)]">
      Índice HTML completo: las {TOPICS.length} guías están enlazadas desde esta página y desde cada guía relacionada.
      El sitemap XML recoge únicamente URL canónicas indexables.
    </p>
  </div>
</section>
