---
import { ATTRACTION } from '../lib/seo';
---

<section id="ubicacion" class="py-14 lg:py-20">
  <div class="container-narrow">
    <header class="max-w-3xl">
      <h2>Location &amp; How to Visit {ATTRACTION.shortName} in {ATTRACTION.city}</h2>
      <p class="mt-4 text-[var(--color-ink-soft)] text-lg">
        {ATTRACTION.fullName} se localiza en {ATTRACTION.streetAddress}, en la Zona Centro de {ATTRACTION.city}. El mapa interactivo a continuación facilita la planificación de tu visita.
      </p>
    </header>

    <div class="mt-8 grid lg:grid-cols-12 gap-6">
      <figure class="surface-card overflow-hidden lg:col-span-8">
        <iframe
          src={ATTRACTION.mapsEmbedSrc}
          width="100%"
          height="450"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          title={`Mapa de ${ATTRACTION.fullName} en ${ATTRACTION.city}`}
        ></iframe>
        <figcaption class="px-4 py-3 text-xs text-[var(--color-ink-soft)] border-t border-[var(--color-border)]">
          Mapa interactivo de Google Maps. Coordenadas: <span class="font-mono">{ATTRACTION.latitude}, {ATTRACTION.longitude}</span>.
        </figcaption>
      </figure>

      <aside class="surface-card-soft p-6 lg:col-span-4">
        <h3 class="text-xl">Cómo llegar</h3>
        <ul class="mt-3 space-y-3 text-sm text-[var(--color-ink-soft)]">
          <li class="flex gap-2">
            <span aria-hidden="true" class="text-[var(--color-accent)] font-bold">●</span>
            <span><strong>A pie:</strong> forma parte del recorrido clásico del centro histórico, a pocos metros del Teatro Degollado.</span>
          </li>
          <li class="flex gap-2">
            <span aria-hidden="true" class="text-[var(--color-accent)] font-bold">●</span>
            <span><strong>Transporte público:</strong> varias rutas de MiBus y la estación del Tren Ligero不远处.</span>
          </li>
          <li class="flex gap-2">
            <span aria-hidden="true" class="text-[var(--color-accent)] font-bold">●</span>
            <span><strong>Auto:</strong> estacionamientos públicos alrededor del centro histórico.</span>
          </li>
        </ul>

        <a class="btn-secondary mt-5 w-full justify-center" href={ATTRACTION.mapsDirectionsUrl} target="_blank" rel="noopener noreferrer">
          Abrir ruta en Google Maps
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17L17 7"/><path d="M7 7h10v10"/>
          </svg>
        </a>

        <p class="mt-4 text-xs text-[var(--color-ink-soft)]">
          Para información turística oficial visita,
          <a href={ATTRACTION.govtTourismUrl} target="_blank" rel="noopener noreferrer">
            {ATTRACTION.country} / {ATTRACTION.state} Portal Oficial de Turismo
          </a>.
        </p>
      </aside>
    </div>
  </div>
</section>