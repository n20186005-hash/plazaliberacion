---
import { ATTRACTION } from '../lib/seo';

// Bloque de tiempo: se hidrata en el cliente para solicitar /api/weather.
// El endpoint se renderiza en Cloudflare Workers y entrega JSON ya
// transformado. Aquí NO se menciona el proveedor de la información ni se
// exponen claves técnicas.
---

<section id="clima" class="py-12 lg:py-16 bg-gradient-to-b from-[var(--color-surface-alt)] to-[var(--color-bg)] border-b border-[var(--color-border)]">
  <div class="container-narrow">
    <header class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="text-xs uppercase tracking-[0.18em] font-semibold text-[var(--color-accent)]">Clima en {ATTRACTION.city}</p>
        <h2 class="mt-2">¿Cómo está el clima ahora en {ATTRACTION.shortName}?</h2>
      </div>
      <p class="text-xs text-[var(--color-ink-soft)] max-w-sm">
        Pronóstico actualizado automáticamente. ¿Saldrás con paraguas? ¿Necesitas protector solar? Esta sección te lo dice antes de salir.
      </p>
    </header>

    <div
      id="weather-root"
      class="mt-8 grid lg:grid-cols-12 gap-6"
      data-loading="true"
      aria-live="polite"
      aria-busy="true"
    >
      <article class="surface-card p-6 lg:col-span-5" aria-label="Tiempo actual">
        <p class="text-xs uppercase tracking-wider text-[var(--color-ink-soft)]">Ahora mismo</p>
        <div class="mt-3 flex items-start gap-4">
          <div class="text-5xl" aria-hidden="true" data-weather-emoji>⛅</div>
          <div>
            <p class="font-serif font-bold text-4xl leading-none" data-weather-temp>—</p>
            <p class="mt-2 text-sm text-[var(--color-ink-soft)]" data-weather-label>Cargando…</p>
          </div>
        </div>
        <p class="mt-3 text-xs text-[var(--color-ink-soft)]" data-weather-summary>—</p>
        <dl class="mt-5 grid grid-cols-2 gap-y-3 gap-x-4 text-sm">
          <div>
            <dt class="text-[var(--color-ink-soft)] text-xs">Sensación</dt>
            <dd class="font-medium" data-weather-apparent>—</dd>
          </div>
          <div>
            <dt class="text-[var(--color-ink-soft)] text-xs">Humedad</dt>
            <dd class="font-medium" data-weather-humidity>—</dd>
          </div>
          <div>
            <dt class="text-[var(--color-ink-soft)] text-xs">Viento</dt>
            <dd class="font-medium" data-weather-wind>—</dd>
          </div>
          <div>
            <dt class="text-[var(--color-ink-soft)] text-xs">Lluvia</dt>
            <dd class="font-medium" data-weather-precip>—</dd>
          </div>
        </dl>
      </article>

      <article class="surface-card p-6 lg:col-span-7" aria-label="Pronóstico de los próximos días">
        <div class="flex items-center justify-between gap-4">
          <h3 class="text-lg">Próximos días</h3>
          <span class="text-xs text-[var(--color-ink-soft)]" data-weather-updated>—</span>
        </div>
        <ol class="mt-4 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3" data-weather-days>
          <!-- Renderizado por JS -->
        </ol>

        <!-- Recomendaciones dinámicas: cada bloque se renderiza sólo si tiene contenido -->
        <div class="mt-6 space-y-3" data-weather-advice-root>
          <div class="surface-card-soft p-4" data-advice-section="risk" hidden>
            <h4 class="text-sm font-semibold text-red-900 flex items-center gap-2">
              <span aria-hidden="true">⚠️</span>
              <span>Precauciones</span>
            </h4>
            <ul class="mt-2 space-y-1 text-sm text-[var(--color-ink-soft)]" data-advice-list="risk"></ul>
          </div>

          <div class="surface-card-soft p-4" data-advice-section="outfit" hidden>
            <h4 class="text-sm font-semibold flex items-center gap-2">
              <span aria-hidden="true">👕</span>
              <span>Ropa y calzado</span>
            </h4>
            <ul class="mt-2 space-y-1 text-sm text-[var(--color-ink-soft)]" data-advice-list="outfit"></ul>
          </div>

          <div class="surface-card-soft p-4" data-advice-section="activities" hidden>
            <h4 class="text-sm font-semibold flex items-center gap-2">
              <span aria-hidden="true">🗓️</span>
              <span>Plan de visita</span>
            </h4>
            <ul class="mt-2 space-y-1 text-sm text-[var(--color-ink-soft)]" data-advice-list="activities"></ul>
          </div>

          <div class="surface-card-soft p-4" data-advice-section="items" hidden>
            <h4 class="text-sm font-semibold flex items-center gap-2">
              <span aria-hidden="true">🎒</span>
              <span>En tu mochila</span>
            </h4>
            <ul class="mt-2 space-y-1 text-sm text-[var(--color-ink-soft)]" data-advice-list="items"></ul>
          </div>
        </div>
      </article>
    </div>

    <p class="mt-4 text-xs text-[var(--color-ink-soft)]" data-weather-fallback hidden>
      No fue posible obtener el estado del tiempo en este momento. La información meteorológica se publica sólo como referencia general y puede diferir de las condiciones reales en la plaza.
    </p>
  </div>
</section>

<script is:inline>
  (function () {
    const root = document.getElementById('weather-root');
    if (!root) return;
    const fallback = document.querySelector('[data-weather-fallback]');

    const set = (sel, val) => {
      const el = root.querySelector(sel);
      if (el && val != null) el.textContent = val;
    };

    function dayName(iso) {
      try {
        const d = new Date(iso);
        return d.toLocaleDateString('es-MX', { weekday: 'short', day: '2-digit', month: 'short' });
      } catch {
        return iso;
      }
    }

    function renderSection(name, items) {
      const section = document.querySelector('[data-advice-section="' + name + '"]');
      const list = document.querySelector('[data-advice-list="' + name + '"]');
      if (!section || !list) return;
      if (!items || !items.length) {
        section.setAttribute('hidden', '');
        return;
      }
      section.removeAttribute('hidden');
      list.innerHTML = items.map((t) => '<li>' + escape(t) + '</li>').join('');
    }

    function escape(s) {
      return String(s)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');
    }

    function render(payload) {
      if (!payload || !payload.current) return;
      const c = payload.current;
      set('[data-weather-emoji]', c.emoji);
      set(
        '[data-weather-temp]',
        typeof c.temperatureC === 'number' ? c.temperatureC.toFixed(1) + ' °C' : '—'
      );
      set('[data-weather-label]', c.label);
      set(
        '[data-weather-apparent]',
        typeof c.apparentTemperatureC === 'number'
          ? c.apparentTemperatureC.toFixed(1) + ' °C'
          : '—'
      );
      set(
        '[data-weather-humidity]',
        typeof c.humidityPct === 'number' ? c.humidityPct + '%' : '—'
      );
      set(
        '[data-weather-wind]',
        typeof c.windKmh === 'number' ? c.windKmh.toFixed(0) + ' km/h' : '—'
      );
      set('[data-weather-precip]', (c.precipitationMm ?? 0).toFixed(1) + ' mm');
      set('[data-weather-summary]', payload.advice?.summary || '');

      const daysEl = root.querySelector('[data-weather-days]');
      if (daysEl && Array.isArray(payload.days)) {
        daysEl.innerHTML = payload.days
          .map(function (d) {
            return (
              '<li class="surface-card-soft p-3 text-center">' +
                '<p class="text-xs font-semibold text-[var(--color-ink)]">' +
                  dayName(d.date) +
                '</p>' +
                '<div class="text-2xl mt-1" aria-hidden="true">' + d.emoji + '</div>' +
                '<p class="text-xs mt-1 text-[var(--color-ink-soft)] leading-tight">' + d.label + '</p>' +
                '<p class="mt-2 text-sm font-medium">' +
                  '<span class="text-[var(--color-accent)]">' + (d.tempMaxC ?? '—') + '°</span>' +
                  ' / ' +
                  '<span class="text-[var(--color-ink-soft)]">' + (d.tempMinC ?? '—') + '°</span>' +
                '</p>' +
                '<p class="text-[10px] text-[var(--color-ink-soft)] mt-1">☔ ' + d.precipProbPct + '%</p>' +
                '<p class="text-[10px] text-[var(--color-ink-soft)] mt-0.5">UV ' + (d.uvMax ?? 0) + '</p>' +
              '</li>'
            );
          })
          .join('');
      }

      const a = payload.advice || {};
      renderSection('risk', a.risk);
      renderSection('outfit', a.outfit);
      renderSection('activities', a.activities);
      renderSection('items', a.items);

      const updatedEl = root.querySelector('[data-weather-updated]');
      if (updatedEl && payload.updatedAt) {
        try {
          const d = new Date(payload.updatedAt);
          updatedEl.textContent =
            'Actualizado: ' + d.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
        } catch {
          updatedEl.textContent = 'Actualizado recientemente';
        }
      }

      root.dataset.loading = 'false';
      root.setAttribute('aria-busy', 'false');
    }

    function showFallback() {
      if (fallback) fallback.removeAttribute('hidden');
      root.dataset.loading = 'false';
      root.setAttribute('aria-busy', 'false');
      set('[data-weather-label]', 'Sin datos');
      set('[data-weather-temp]', '—');
    }

    fetch('/api/weather', { headers: { Accept: 'application/json' } })
      .then((r) => (r.ok ? r.json() : Promise.reject(r)))
      .then(render)
      .catch(showFallback);
  })();
</script>