---
import { ATTRACTION } from '../lib/seo';

const audiences = [
  {
    id: 'familias',
    title: 'Familias con niñas y niños',
    badge: 'Pace: tranquilo',
    description: 'Recorrido con pausas frecuentes, zonas seguras a la sombra y actividades breves que mantienen la atención de los más pequeños.',
    tips: [
      'Evita las horas de mayor calor (13:00 – 16:00) y lleva protector solar.',
      'Identifica los baños públicos antes de iniciar el recorrido.',
      'Lleva una botella reutilizable: hay fuentes de agua potable cercanas.',
      'Considera un snack ligero por si la caminata se extiende.'
    ]
  },
  {
    id: 'fotografia',
    title: 'Fotografía de naturaleza y arquitectura',
    badge: 'Pace: pausado · mejor luz',
    description: 'Itinerario optimizado para capturar luz dorada, simetría arquitectónica y escenas urbanas con poca gente.',
    tips: [
      'Primera hora de la mañana: calles semivacías y luz suave.',
      'Atardecer: contraluz sobre las fachadas neoclásicas del Teatro Degollado.',
      'Noche entre semana: atmósfera iluminada para tomas arquitectónicas.',
      'Usa trípode ligero sólo en zonas donde no incomode el paso de visitantes.'
    ]
  },
  {
    id: 'accesible',
    title: 'Personas con movilidad reducida o ruta de baja exigencia',
    badge: 'Pace: muy tranquilo',
    description: 'Recorrido esencialmente plano, con pavimentos regulares y múltiples puntos de descanso a la sombra.',
    tips: [
      'El conjunto Plaza–Palacio–Catedral se recorre por superficies regulares, aptas para silla de ruedas.',
      'Hay bancos cada 50 – 100 metros a lo largo del circuito.',
      'El ingreso al vestíbulo del Teatro Degollado puede requerir escaleras; consulta acceso alternativo.',
      'Considera visitar en horas de baja densidad para mayor comodidad.'
    ]
  }
];
---

<section id="audiencias" class="py-14 lg:py-20">
  <div class="container-narrow">
    <header class="max-w-3xl">
      <p class="text-xs uppercase tracking-[0.18em] font-semibold text-[var(--color-accent)]">Rutas por audiencia</p>
      <h2 class="mt-2">Tres rutas adaptadas a tu forma de viajar</h2>
      <p class="mt-4 text-[var(--color-ink-soft)] text-lg">
        Selecciona el perfil que mejor describa a tu grupo. Cada ruta prioriza un ritmo y unos puntos de interés específicos; todas pueden ampliarse o reducirse según tu tiempo disponible.
      </p>
    </header>

    <div class="mt-8 grid lg:grid-cols-3 gap-6">
      {audiences.map((a) => (
        <article class="surface-card p-6 flex flex-col">
          <p class="text-[10px] font-semibold uppercase tracking-wider text-[var(--color-accent)]">{a.badge}</p>
          <h3 class="mt-2 text-xl">{a.title}</h3>
          <p class="mt-3 text-sm text-[var(--color-ink-soft)]">{a.description}</p>
          <ul class="mt-4 space-y-2 text-sm text-[var(--color-ink-soft)] list-disc pl-5 flex-1">
            {a.tips.map((tip) => <li>{tip}</li>)}
          </ul>
          <a href="#rutas" class="mt-5 text-sm font-semibold text-[var(--color-accent)]">Combinar con rutas generales →</a>
        </article>
      ))}
    </div>
  </div>
</section>