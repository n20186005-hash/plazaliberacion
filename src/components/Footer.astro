---
import { ATTRACTION, SITE_CONFIG } from '../lib/seo';

interface Props {
  topic?: boolean;
}
const { topic = false } = Astro.props;
const prefix = topic ? '/' : '';
const year = new Date().getFullYear();
---

<footer class="bg-[var(--color-ink)] text-[var(--color-bg)] py-10">
  <div class="container-narrow grid sm:grid-cols-2 lg:grid-cols-4 gap-8 text-sm">
    <div>
      <p class="font-serif font-bold text-lg">Plaza Liberación</p>
      <p class="mt-2 text-[var(--color-border)] opacity-90">
        Guía independiente y sin ánimo de lucro de información turística y divulgación para visitantes de {ATTRACTION.fullName} en {ATTRACTION.city}, {ATTRACTION.state}, {ATTRACTION.country}.
      </p>
      <p class="mt-3 text-xs opacity-70">Dominio: {SITE_CONFIG.domain}</p>
    </div>

    <nav aria-label="Enlaces del sitio">
      <p class="font-semibold">Sitio</p>
      <ul class="mt-2 space-y-1 opacity-90">
        <li><a href={`${prefix}#sobre`} class="text-[var(--color-bg)] no-underline hover:underline">Sobre la plaza</a></li>
        <li><a href={`${prefix}#opiniones`} class="text-[var(--color-bg)] no-underline hover:underline">Opiniones</a></li>
        <li><a href={`${prefix}#ubicacion`} class="text-[var(--color-bg)] no-underline hover:underline">Ubicación</a></li>
        <li><a href={`${prefix}#guias`} class="text-[var(--color-bg)] no-underline hover:underline">Guías temáticas (36)</a></li>
        <li><a href={`${prefix}#preguntas`} class="text-[var(--color-bg)] no-underline hover:underline">Preguntas</a></li>
        <li><a href={`${prefix}#fuentes`} class="text-[var(--color-bg)] no-underline hover:underline">Fuentes</a></li>
      </ul>
    </nav>

    <nav aria-label="Enlaces oficiales">
      <p class="font-semibold">Enlaces oficiales</p>
      <ul class="mt-2 space-y-1 opacity-90">
        <li>
          <a href={ATTRACTION.mapsShareUrl} target="_blank" rel="noopener noreferrer" class="text-[var(--color-bg)] no-underline hover:underline">
            Google Maps · Plaza Liberación ↗
          </a>
        </li>
        <li>
          <a href={ATTRACTION.mapsDirectionsUrl} target="_blank" rel="noopener noreferrer" class="text-[var(--color-bg)] no-underline hover:underline">
            Cómo llegar en Google Maps ↗
          </a>
        </li>
        <li>
          <a href={ATTRACTION.govtTourismUrl} target="_blank" rel="noopener noreferrer" class="text-[var(--color-bg)] no-underline hover:underline">
            {ATTRACTION.state} · Turismo oficial ↗
          </a>
        </li>
      </ul>
    </nav>

    <div>
      <p class="font-semibold">Avisos</p>
      <ul class="mt-2 space-y-1 opacity-90 text-xs leading-relaxed">
        <li>Solo se muestra la calificación y el número de reseñas; no reproducimos el texto de las reseñas con atribución y fecha de consulta.</li>
        <li>Ilustración geométrica original CC0; no es foto ni representación de instalaciones o arte de la plaza.</li>
        <li>Sin analítica propia configurada. Maps y Cloudflare pueden tratar datos de conexión; consulta el aviso de privacidad.</li>
      </ul>
    </div>
  </div>

  <div class="container-narrow mt-10 pt-6 border-t border-white/10 flex flex-wrap items-center justify-between gap-4 text-xs opacity-75">
    <p>© {year} {SITE_CONFIG.name}. Hecho con Astro · Cloudflare.</p>
    <p>
      v1.0.0 · Consulta de reseñas: {ATTRACTION.reviewsLastSyncLabel}
    </p>
  </div>
<p class="container-narrow mt-4 text-xs"><a href={`${prefix}#privacidad`}>Privacidad y condiciones</a></p></footer>