---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import AboutSection from '../components/AboutSection.astro';
import ReviewsBlock from '../components/ReviewsBlock.astro';
import LocationSection from '../components/LocationSection.astro';
import LandmarksSection from '../components/LandmarksSection.astro';
import HistorySection from '../components/HistorySection.astro';
import SeasonalStrategySection from '../components/SeasonalStrategySection.astro';
import ItinerarySection from '../components/ItinerarySection.astro';
import AudienceRoutesSection from '../components/AudienceRoutesSection.astro';
import PracticalInfoSection from '../components/PracticalInfoSection.astro';
import WeatherBlock from '../components/WeatherBlock.astro';
import VisitorEducationSection from '../components/VisitorEducationSection.astro';
import FAQSection from '../components/FAQSection.astro';
import SourcesSection from '../components/SourcesSection.astro';
import TopicLinks from '../components/TopicLinks.astro';
import Footer from '../components/Footer.astro';
import { ATTRACTION } from '../lib/seo';

// Prerender del HTML en build para mantener SEO y velocidad.
// Solo el endpoint /api/weather se ejecuta en Cloudflare Workers.
export const prerender = true;

const pageTitle = 'Plaza de la Liberación Guadalajara | Historia, Ubicación y Qué Ver';
const pageDescription = 'Conoce la Plaza de la Liberación en Guadalajara: su historia, las fuentes, el monumento a Miguel Hidalgo, cómo llegar y qué visitar cerca.';
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/"
  ogImage={ATTRACTION.heroImage}
>
  <Header />

  <main id="main">
    <Hero />
    <TopicLinks />
    <WeatherBlock />
    <AboutSection />
    <ReviewsBlock />
    <LocationSection />
    <LandmarksSection />
    <HistorySection />
    <SeasonalStrategySection />
    <ItinerarySection />
    <AudienceRoutesSection />
    <PracticalInfoSection />
    <VisitorEducationSection />
    <FAQSection />
    <SourcesSection />
  </main>

  <Footer />
</BaseLayout>